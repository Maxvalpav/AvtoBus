<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyWorker</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Контент шаблона, не часть сборки: вне CPM и lock-файлов. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="AvtoBus" Version="0.1.0" />
    <PackageReference Include="AvtoBus.InMemory" Version="0.1.0" />
<!--#if (transport == "kafka")
    <PackageReference Include="AvtoBus.Kafka" Version="0.1.0" />
#elif (transport == "redis")
    <PackageReference Include="AvtoBus.Redis" Version="0.1.0" />
#endif-->
  </ItemGroup>

</Project>