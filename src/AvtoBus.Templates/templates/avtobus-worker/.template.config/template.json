{
  "$schema": "http://json.schemastore.org/template",
  "author": "AvtoBus",
  "classifications": ["AvtoBus", "EDA", "Worker", "Microservices"],
  "identity": "AvtoBus.Templates.Worker",
  "name": "AvtoBus Worker Service",
  "shortName": "avtobus-worker",
  "sourceName": "MyWorker",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "transport": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "inmemory", "description": "In-memory транспорт (по умолчанию)" },
        { "choice": "kafka", "description": "Kafka транспорт" },
        { "choice": "redis", "description": "Redis Streams транспорт" }
      ],
      "defaultValue": "inmemory",
      "replaces": "//__TRANSPORT__//"
    }
  }
}