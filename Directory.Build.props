<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574;CS1734</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591;CS1573;CS1574;CS1734;NU5128</WarningsNotAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Аудит D5: trim/AOT-анализаторы на уровне шиппаемых библиотек.
         Тесты/бенчмарки/семплы/шаблоны не анализируем: они намеренно вызывают
         reflection-API. Условие по имени/пути — IsPackable в props ещё не видно. -->
    <IsAotCompatible Condition="'$(IsAotCompatible)' == '' and $(MSBuildProjectName.Contains('Tests')) != 'true' and $(MSBuildProjectName.Contains('Benchmarks')) != 'true' and $(MSBuildProjectDirectory.Contains('samples')) != 'true' and $(MSBuildProjectDirectory.Contains('Templates')) != 'true'">true</IsAotCompatible>
    <!-- Аудит D1: ворота уязвимостей. С TreatWarningsAsErrors NU1901–NU1904 становятся ошибками сборки. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- E-06: семплы/бенчмарки/тесты не пакуются — `dotnet pack AvtoBus.slnx`
         собирает только src/*. Условие по пути (IsPackable в props ещё не видно).
         src/AvtoBus.Templates под правило не попадает (путь src/, не tests/). -->
    <IsPackable Condition="$(MSBuildProjectDirectory.Contains('samples')) == 'true' or $(MSBuildProjectDirectory.Contains('benchmarks')) == 'true' or $(MSBuildProjectDirectory.Contains('tests')) == 'true'">false</IsPackable>
    <!-- Аудит D2: детерминированный restore. Lock-файлы коммитятся;
         CI проверяет locked mode, Dependabot-регены — обязанность автора PR. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>AvtoBus</Authors>
    <Product>AvtoBus</Product>
    <Description>AvtoBus - EDA framework for ASP.NET Core. Садись и езжай.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Версия — только из MinVer-тега v* (аудит D3): VersionPrefix удалён, иначе расхождение с CHANGELOG. -->
    <RepositoryUrl>https://github.com/Maxvalpav/AvtoBus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Label="MinVer">
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup Label="MinVer" Condition="'$(IsPackable)' == 'true' or '$(IsPackable)' == ''">
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!-- E-05: SDK тащит Microsoft.NET.ILLink.Tasks неявно с плавающей версией (от версии SDK),
       из-за чего трескались lock-файлы. Делаем ссылку явной — версия берётся из CPM
       (Directory.Packages.props), restore детерминирован на любом SDK 10.0.x. -->
  <ItemGroup Label="SDK implicit pin">
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <!-- Уровни зрелости пакетов (аудит 03 §1.1): Stable — SemVer и совместимость;
       Preview — API может меняться в миноре; Experimental — без гарантий.
       Уровень виден в PackageTags и в стартовых логах (WarnExperimental). -->
  <PropertyGroup Label="Package maturity">
    <AvtoBusStableProjects>;AvtoBus;AvtoBus.Abstractions;AvtoBus.Core;AvtoBus.Generators;AvtoBus.InMemory;AvtoBus.Outbox.EfCore;AvtoBus.RabbitMq;AvtoBus.Testing;</AvtoBusStableProjects>
    <AvtoBusExperimentalProjects>;AvtoBus.Actors;AvtoBus.Bridge;AvtoBus.Canvas;AvtoBus.Dashboard;AvtoBus.EventSourcing;AvtoBus.Multitenancy;AvtoBus.SchemaRegistry;AvtoBus.Streams;AvtoBus.Workflow;</AvtoBusExperimentalProjects>
    <AvtoBusMaturity Condition="$(AvtoBusStableProjects.Contains(';$(MSBuildProjectName);'))">stable</AvtoBusMaturity>
    <AvtoBusMaturity Condition="'$(AvtoBusMaturity)' == '' and $(AvtoBusExperimentalProjects.Contains(';$(MSBuildProjectName);'))">experimental</AvtoBusMaturity>
    <AvtoBusMaturity Condition="'$(AvtoBusMaturity)' == ''">preview</AvtoBusMaturity>
    <!-- Для непакуемых (тесты/семплы/бенчмарки) тег ни на что не влияет. -->
    <PackageTags>avtobus;avtobus-maturity-$(AvtoBusMaturity)</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="SourceLink">
    <!-- Символы и SourceLink включаются только в release-сборке CI
         (ContinuousIntegrationBuild=true), чтобы локальные сборки оставались чистыми:
         без git-remote локально SourceLink-таргеты дают предупреждения, а пустой
         символьный пакет шаблонов даёт NU5017. Шаблоны в release не пакуются. -->
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">false</ContinuousIntegrationBuild>
    <IncludeSymbols Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</IncludeSymbols>
    <SymbolPackageFormat Condition="'$(ContinuousIntegrationBuild)' == 'true'">snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Label="SourceLink" Condition="'$(ContinuousIntegrationBuild)' == 'true' AND ('$(IsPackable)' == 'true' or '$(IsPackable)' == '')">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Label="Package metadata" Condition="'$(IsPackable)' == 'true' or '$(IsPackable)' == ''">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
