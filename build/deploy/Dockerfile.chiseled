# Syntax=docker/dockerfile:1

# chiseled: минимальный дистрибутив Ubuntu без менеджера пакетов и шелла (идея 470).
# Запускается как non-root, сокращает поверхность атаки и размер образа.
FROM mcr.microsoft.com/dotnet/runtime-deps:10.0-jammy-chiseled AS base

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore кэшируется отдельно: правки исходников не перекачивают пакеты.
COPY nuget.config global.json Directory.Build.props Directory.Packages.props ./
COPY src/ src/
RUN dotnet restore src/AvtoBus.Cli/AvtoBus.Cli.csproj && dotnet publish src/AvtoBus.Cli/AvtoBus.Cli.csproj -c Release -o /app --no-restore

FROM base AS final
WORKDIR /app
COPY --from=build /app ./

# chiseled-образы уже бегут под non-root пользователем (1654 = app).
USER 1654

# Пробы: /healthz (liveness), /readyz (readiness), /startupz (идея 468).
EXPOSE 8080
ENTRYPOINT ["dotnet", "avtobus.dll"]